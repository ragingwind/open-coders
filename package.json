{
  "name": "open-coders",
  "version": "0.1.0",
  "description": "The open-coders command-line tool.",
  "type": "module",
  "bin": {
    "open-coders": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20",
    "bun": ">=1.3.0"
  },
  "scripts": {
