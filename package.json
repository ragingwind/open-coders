{
  "name": "open-coders",
  "version": "0.1.0",
  "description": "The open-coders command-line tool.",
  "type": "module",
  "bin": {
    "open-coders": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run test",
    "dev": "bun src/index.ts",
    "start": "bun dist/index.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "zod": "^4.6.7"
  }
}
